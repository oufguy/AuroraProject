Windows Registry Editor Version 5.00

; ============================================================================
; Aurora Engine - File Type Association & Icon for .aurora Project Files
; Double-clicking this file registers Aurora Studio as the default editor.
; ============================================================================

[HKEY_CURRENT_USER\Software\Classes\.aurora]
@="AuroraProject.File"
"Content Type"="application/x-aurora-project"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\AuroraProject.File]
@="Aurora Engine Project"
"FriendlyTypeName"="Aurora Engine Project"

[HKEY_CURRENT_USER\Software\Classes\AuroraProject.File\DefaultIcon]
@="\"D:\\AuroraProject\\Editor\\Resources\\EditorIcon.ico\""

[HKEY_CURRENT_USER\Software\Classes\AuroraProject.File\shell]
@="open"

[HKEY_CURRENT_USER\Software\Classes\AuroraProject.File\shell\open]
@="Open with Aurora Studio"
"Icon"="\"D:\\AuroraProject\\Editor\\Resources\\EditorIcon.ico\""

[HKEY_CURRENT_USER\Software\Classes\AuroraProject.File\shell\open\command]
@="\"D:\\AuroraProject\\AuroraEditor.exe\" \"%1\""
