# Aurora Engine - Medieval Town House Model
# Format: Wavefront OBJ
# Ground floor
v -4.0 0.0 -4.0
v  4.0 0.0 -4.0
v  4.0 0.0  4.0
v -4.0 0.0  4.0
# Eaves level
v -4.0 4.0 -4.0
v  4.0 4.0 -4.0
v  4.0 4.0  4.0
v -4.0 4.0  4.0
# Roof ridge
v -4.2 6.5 0.0
v  4.2 6.5 0.0
# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
# Normals
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn -0.7  0.7  0.0
vn  0.7  0.7  0.0
# Front Wall (Z = 4)
f 4/1/3 3/2/3 7/3/3
f 4/1/3 7/3/3 8/4/3
# Back Wall (Z = -4)
f 2/1/1 1/2/1 5/3/1
f 2/1/1 5/3/1 6/4/1
# Right Wall (X = 4)
f 3/1/2 2/2/2 6/3/2
f 3/1/2 6/3/2 7/4/2
# Left Wall (X = -4)
f 1/1/4 4/2/4 8/3/4
f 1/1/4 8/3/4 5/4/4
# Front Gable Triangle
f 8/1/3 7/2/3 10/3/3
f 8/1/3 10/3/3 9/4/3
# Back Gable Triangle
f 6/1/1 5/2/1 9/3/1
f 6/1/1 9/3/1 10/4/1
# Roof Slope Left
f 5/1/6 8/2/6 9/3/6
# Roof Slope Right
f 7/1/7 6/2/7 10/3/7
